NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fabnix:fabnix@localhost:5432/fabnix
# Comma-separated origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
# Rate limits per route per client IP (per minute). AUTH applies to login/register/OTP/reset.
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
# The web app proxies /api/v1 (same-origin cookies). Set true when the API is only
# reachable through that proxy / a load balancer so rate limits use the real client IP.
# Hop count: 1 = one proxy (e.g. docker-compose web → API); 2 = Vercel → Railway edge → API.
TRUST_PROXY=true
# Require email/phone verification before login (FR-001)
AUTH_REQUIRE_VERIFICATION=true
# New shops become ACTIVE without Super Admin approval (pilot convenience)
SHOP_AUTO_APPROVE=true
# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fabnix-media
S3_ACCESS_KEY_ID=fabnix
S3_SECRET_ACCESS_KEY=fabnix-secret
S3_FORCE_PATH_STYLE=true
# Background jobs (reservation expiry sweeper)
JOBS_ENABLED=true
RESERVATION_SWEEP_INTERVAL_MS=60000
# Messaging: console logs OTP/email/SMS in dev
MESSAGING_DRIVER=console
