// =============================================================================
// FABNIX — Prisma schema (PostgreSQL 16+)
// SRS v1.1 · Milestone 1 baseline · 2026-11-19
//
// Conventions
//   • UUIDv7 primary keys (time-ordered → better B-tree locality than v4).
//   • Lengths      : Decimal(14,4)  canonical INCHES                (BR-003)
//   • Money        : Decimal(14,2)  in the shop's currency          (BR-010)
//   • Conv. factors: Decimal(18,8)  inches per unit                 (FR-013)
//   • Rates/cost   : Decimal(14,4) per price unit; Decimal(18,6) per inch
//   • Tax %        : Decimal(7,4)   e.g. 15.0000
//   • Timestamps   : timestamptz, stored UTC                        (BR-014)
//   • Tenant-owned rows carry shopId. Children reference parents through
//     COMPOSITE FKs (shopId, id) so a row can never point at another shop's
//     product/customer/branch, even if application code is wrong (§8.2).
//   • Append-only ledgers (stock_movements, payments, *_status_history,
//     audit_logs, admin_audit_logs) are additionally protected by triggers in
//     prisma/sql/constraints.sql (BR-009, BR-015).
//   • CHECK constraints, partial unique indexes and trigram search indexes
//     that Prisma cannot express live in prisma/sql/constraints.sql and are
//     appended to the initial migration.
//   • Actor columns named *ById without a Prisma relation are plain user ids;
//     attribution is also recorded in audit_logs.
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts (Prisma 7).
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

