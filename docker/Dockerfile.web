# syntax=docker/dockerfile:1.7
# FABNIX web (Next.js 15) — API_URL is baked into the /api/v1 + /media rewrites at build time.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @fabnix/web --workspace @fabnix/shared --include-workspace-root --ignore-scripts

FROM deps AS build
ARG API_URL=http://backend:4000
ENV API_URL=$API_URL NEXT_TELEMETRY_DISABLED=1
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN npm run build -w @fabnix/shared && npm run build -w @fabnix/web

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN groupadd -r fabnix && useradd -r -g fabnix fabnix
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/apps/web/package.json /app/apps/web/next.config.ts ./apps/web/
COPY --from=build /app/apps/web/.next ./apps/web/.next
COPY --from=build /app/apps/web/public ./apps/web/public
COPY --from=build /app/apps/web/messages ./apps/web/messages
WORKDIR /app/apps/web
USER fabnix
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
